include README.md README.zh-CN.md LICENSE CITATION.cff CHANGELOG.md CONTRIBUTING.md
recursive-include docs *.md
recursive-include tests *.py
recursive-include scripts *.py
include reproduction/README.md
prune reproduction/l96
exclude reproduction/SOURCE.json
prune private
prune outputs
prune .venv
prune .venv-wheel
global-exclude *.pyc
global-exclude .env .env.* *.pem *.key *.pfx *.p12 credentials*.json
